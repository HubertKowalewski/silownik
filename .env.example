# Skopiuj do pliku .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# Domena, pod którą działa aplikacja (Caddy pobierze dla niej certyfikat HTTPS)
DOMAIN=silownik.example.pl

# Django
DJANGO_DEBUG=0
# wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=zmien-mnie
DJANGO_ADMINS=admin@example.pl
GUNICORN_WORKERS=3

# Pierwsze konto administratora (tworzone przy starcie, jeśli nie istnieje)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.pl
DJANGO_SUPERUSER_PASSWORD=zmien-mnie

# Baza danych PostgreSQL
POSTGRES_DB=silownik
POSTGRES_USER=silownik
POSTGRES_PASSWORD=zmien-mnie

# Poczta (reset hasła). Bez EMAIL_HOST wiadomości trafiają tylko do dziennika serwera.
EMAIL_HOST=smtp.example.pl
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.pl
EMAIL_HOST_PASSWORD=zmien-mnie
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Siłownik <no-reply@example.pl>
